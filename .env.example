# Cloudflare Turnstile site key (public — baked into the client bundle)
VITE_TURNSTILE_SITE_KEY=

# Dedicated WhatsApp Business number in E.164 format (e.g. +447XXXXXXXXX).
# Used only on /contact for optional click-to-chat. Omit to hide the WhatsApp block.
VITE_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Server-only secrets — set in Lovable / Cloudflare Worker environment.
# Never prefix these with VITE_ (they must not reach the browser).
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# LEAD_FROM=Reacting Website <website@reacting.io>
# LEAD_TO=
# TURNSTILE_SECRET_KEY=


